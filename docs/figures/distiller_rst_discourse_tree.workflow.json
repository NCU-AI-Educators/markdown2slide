{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "篇章修辞结构 (RST) 要点拆解与幻灯片对应关系",
    "locale": "zh-CN",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "rst-distillation-flow",
        "label": "RST 认知要点提炼与幻灯片映射",
        "focus": [
          "node_raw",
          "node_thesis",
          "node_section",
          "node_nucleus",
          "node_satellite",
          "node_h2_lead",
          "node_bullets",
          "node_slide_draft"
        ],
        "note": "长文先提炼全篇主旨，再按章节拆分议题，然后区分必须保留的核心论点与需要精简的补充论据，最终对应到幻灯片各区域。"
      }
    ]
  },
  "lanes": [
