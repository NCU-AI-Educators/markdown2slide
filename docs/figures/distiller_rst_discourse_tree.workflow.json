    { "id": "lane_nucleus", "label": "核心论点轨 (Nucleus / 必须保留)" },
    { "id": "lane_satellite", "label": "补充论据轨 (Satellite / 浓缩精炼)" },
    { "id": "lane_slide", "label": "幻灯片装配轨 (Slide Elements)" }
