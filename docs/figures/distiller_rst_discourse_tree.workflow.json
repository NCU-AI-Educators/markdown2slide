    { "id": "p_mapping", "label": "第 4 阶段：对应页面位置", "fromCol": 4, "toCol": 4 },
    { "id": "p_output", "label": "第 5 阶段：生成初始草稿", "fromCol": 5, "toCol": 5, "variant": "security" }
  ],
  "groups": [
    { "id": "grp_rst_split", "label": "主次要点分类", "lane": "lane_nucleus", "fromCol": 3, "toCol": 4, "variant": "emphasis" }
