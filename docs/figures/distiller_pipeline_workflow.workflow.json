{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "长文转幻灯片草稿的 5 步提炼工序",
    "locale": "zh-CN",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "distiller-pipeline-view",
        "label": "长文要点提炼与演说节奏编排流水线",
        "focus": [
          "node_raw_in",
          "node_ast_parse",
          "node_beat_slice",
          "node_text_rewrite",
          "node_intent_tag",
          "node_contract_deliver"
        ],
        "note": "输入长文后，依次通过大纲解析、演说节奏分页、段落文字精简、排版意图标注和容量检查，生成纯净规范的演示文稿草稿。"
      }
    ]
  },
  "lanes": [
    { "id": "lane_doc", "label": "文档大纲轨 (Document AST Track)" },
    { "id": "lane_pacing", "label": "演说分页轨 (Cognitive Pacing Track)" },
    { "id": "lane_distill", "label": "文字精炼轨 (Text Refinement Track)" },
    { "id": "lane_contract", "label": "质量检查轨 (Quality Check Track)" }
  ],
  "phases": [
    { "id": "phase_ingest", "label": "第 1 阶段：输入与大纲解析", "fromCol": 0, "toCol": 1 },
    { "id": "phase_pacing", "label": "第 2 阶段：演说节奏拆页", "fromCol": 2, "toCol": 2, "variant": "emphasis" },
    { "id": "phase_rewrite", "label": "第 3 阶段：文字精炼与意图", "fromCol": 3, "toCol": 4 },
    { "id": "phase_deliver", "label": "第 4 阶段：质量检查与交付", "fromCol": 5, "toCol": 5, "variant": "security" }
  ],
  "groups": [
    { "id": "grp_distill", "label": "核心提炼与节奏处理", "lane": "lane_distill", "fromCol": 2, "toCol": 4, "variant": "emphasis" }
  ],
  "mainPath": [
    "node_raw_in",
    "node_ast_parse",
    "node_beat_slice",
    "node_text_rewrite",
    "node_intent_tag",
    "node_contract_deliver"
  ],
  "nodes": [
    {
      "id": "node_raw_in",
      "lane": "lane_doc",
      "col": 0,
      "type": "external",
      "label": "输入 Markdown 长文",
      "sublabel": "技术博客、长篇报告或教材",
      "tag": "输入源",
      "width": 140
    },
    {
      "id": "node_ast_parse",
      "lane": "lane_doc",
      "col": 1,
      "type": "backend",
      "label": "第 1 步：解析文档大纲",
      "sublabel": "识别标题层级与核心论点",
      "tag": "大纲梳理",
      "width": 140
    },
    {
      "id": "node_beat_slice",
      "lane": "lane_pacing",
      "col": 2,
      "type": "frontend",
      "label": "第 2 步：按节奏分页",
      "sublabel": "每页只讲一件事，用 --- 隔开",
      "tag": "单页切分",
      "width": 140
    },
    {
      "id": "node_text_rewrite",
      "lane": "lane_distill",
      "col": 3,
      "type": "frontend",
      "label": "第 3 步：精简段落文字",
      "sublabel": "删掉冗长修饰，改为加粗短语",
      "tag": "文字提炼",
      "width": 140
    },
    {
      "id": "node_intent_tag",
      "lane": "lane_distill",
      "col": 4,
      "type": "cloud",
      "label": "第 4 步：标注排版意图",
      "sublabel": "标明对比、代码或重点提示",
      "tag": "意图标注",
      "width": 140
    },
    {
      "id": "node_contract_deliver",
      "lane": "lane_contract",
      "col": 5,
      "type": "security",
      "label": "第 5 步：检查与交付",
      "sublabel": "单页在180字以内，不写HTML",
      "tag": ".raw_draft.md",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "e_raw_ast",
      "from": "node_raw_in",
      "to": "node_ast_parse",
      "label": "抽取大纲层级"
    },
    {
      "id": "e_ast_beat",
      "from": "node_ast_parse",
      "to": "node_beat_slice",
      "label": "划分演说章节"
    },
    {
      "id": "e_beat_rew",
      "from": "node_beat_slice",
      "to": "node_text_rewrite",
      "label": "按页精简文字"
    },
    {
      "id": "e_rew_tag",
      "from": "node_text_rewrite",
      "to": "node_intent_tag",
      "label": "匹配展示场景"
    },
    {
      "id": "e_tag_deliver",
      "from": "node_intent_tag",
      "to": "node_contract_deliver",
      "label": "核验容量并输出"
    }
  ]
}
